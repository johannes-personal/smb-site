# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Low privilege, ships to the browser;
# RLS decides what it can see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Bypasses RLS entirely. Server only — never give
# this a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# The legacy anon / service_role keys still work and are accepted as a
# fallback, but Supabase retires them at the end of 2026:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_ID=
NEXT_PUBLIC_SITE_URL=
